# FEBROS16 BACKEND - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual secrets. Do NOT commit .env.

# Server Configuration
PORT=8080
ENV=development # development, staging, production

# Database Configuration (PostgreSQL/Supabase)
# Format: postgres://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgres://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Security / Authentication
# Must be a long, random, secret string used for signing JWTs
JWT_SECRET=your_super_secret_jwt_key_here

# CORS Configuration
# Comma-separated list of allowed origins. Use * ONLY in development.
# Example: https://febros16.com,https://www.febros16.com
ALLOWED_ORIGINS=http://localhost:3000
